# Optionale Voreinstellungen (der Benutzer kann sie in der UI ändern)
#
# Wichtig für den Docker-Build: Vite baut ALLE LSWUI_*-Werte in das
# öffentliche, statische JS-Bundle ein. Deshalb sollte LSWUI_API_KEY beim
# Docker-Build leer bleiben – den Schlüssel geben Benutzer zur Laufzeit in
# der Einstellungen-Sektion ein (wird nur im Browser gespeichert).
#
# Für die lokale Entwicklung (npm run dev) kann der Schlüssel hier gesetzt
# werden, damit er nicht jedes Mal eingegeben werden muss.
LSWUI_ANALYSE_URL=https://api.leichte-sprache.ai/analyse?format=full
LSWUI_BASE_URL=
LSWUI_MODEL=
LSWUI_API_KEY=
